<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Lets this project act as startup project for `dotnet ef migrations add`. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.Meterbolt\BTCPayServer.Plugins.Meterbolt.csproj" />
    <ProjectReference Include="..\..\submodules\btcpayserver\BTCPayServer.Tests\BTCPayServer.Tests.csproj" />
  </ItemGroup>

  <!-- This will make sure that referencing BTCPayServer doesn't put any artifact in the published directory -->
  <ItemDefinitionGroup>
      <ProjectReference>
          <Properties>StaticWebAssetsEnabled=false</Properties>
      </ProjectReference>
  </ItemDefinitionGroup>

  <!-- The BTCPay test server reads appsettings.dev.json from the output folder and loads the plugin from DEBUG_PLUGINS. -->
  <Target Name="WriteDebugPluginsConfig" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)appsettings.dev.json" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="{ &quot;DEBUG_PLUGINS&quot;: &quot;$([System.IO.Path]::GetFullPath('$(OutDir)BTCPayServer.Plugins.Meterbolt.dll'))&quot; }" />
  </Target>
</Project>